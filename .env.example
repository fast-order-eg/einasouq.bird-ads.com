NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL="mysql://root:@localhost:3306/adscope_db"

SESSION_SECRET=replace_with_32_char_secret
ENCRYPTION_KEY=replace_with_32_byte_hex_key

META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
META_USER_TOKEN=optional_direct_user_token

GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path_to_service_account.json
VERTEX_QUALITY_MODEL=gemini-2.5-pro
VERTEX_FAST_MODEL=gemini-2.5-flash

STORAGE_PROVIDER=local
DEFAULT_COUNTRY=EG
DEFAULT_LOCALE=ar
